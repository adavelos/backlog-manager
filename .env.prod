# Production settings for the backlog container. Not secret: secrets are in .env.prod.secrets on the server.
BACKLOG_DATA_DIR=/data
BACKLOG_STATIC_DIR=/srv/static
BACKLOG_PORT=8000
BACKLOG_MCP_ALLOWED_HOSTS=seansoul.gr,seansoul.gr:*,backlog:*,127.0.0.1:*,localhost:*
BACKLOG_MCP_ALLOWED_ORIGINS=https://seansoul.gr,localhost
BACKLOG_OAUTH_ISSUER=https://seansoul.gr/authelia
BACKLOG_OAUTH_RESOURCE=https://seansoul.gr/bm/mcp
BACKLOG_OAUTH_JWKS_URL=http://authelia:9091/authelia/jwks.json
